{
  "name": "@vedixa/api",
  "version": "0.1.0",
  "private": true,
  "description": "VEDIXA API Server — Fastify 5 Modular Monolith",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test:unit": "vitest run --reporter=verbose tests/unit",
    "test:integration": "vitest run --reporter=verbose tests/integration",
    "test:e2e": "vitest run --reporter=verbose tests/e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/core/db/migrate.ts",
    "db:migrate:fresh": "tsx src/core/db/migrate-fresh.ts",
    "db:seed": "tsx src/core/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "content:ingest": "tsx scripts/content-ingest.ts",
    "content:seed-syllabus": "tsx scripts/seed-syllabus.ts"
  },
  "dependencies": {
    "@vedixa/types": "workspace:*",
    "@vedixa/schemas": "workspace:*",
    "@vedixa/syllabus-dag": "workspace:*",
    "fastify": "^5.6.3",
    "@fastify/cors": "^5.6.3",
    "@fastify/helmet": "^5.6.3",
    "@fastify/jwt": "^5.6.3",
    "@fastify/rate-limit": "^5.6.3",
    "@fastify/multipart": "^5.6.3",
    "@fastify/sensible": "^5.6.3",
    "@fastify/swagger": "^5.6.3",
    "@fastify/swagger-ui": "^5.6.3",
    "pino": "^5.6.3",
    "drizzle-orm": "^5.6.3",
    "postgres": "^5.6.3",
    "ioredis": "^5.6.3",
    "bullmq": "^5.6.3",
    "argon2": "^5.6.3",
    "uuid": "^5.6.3",
    "date-fns": "^5.6.3",
    "zod": "^5.6.3",
    "@google/generative-ai": "^5.6.3",
    "openai": "^5.6.3",
    "dotenv": "^5.6.3",
    "pino-pretty": "^5.6.3"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "drizzle-kit": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.4",
    "@vitest/coverage-v8": "^2.1.4",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.8.7"
  }
}
