# VEDIXA – Environment Variables

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vedixa:vedixa_dev@localhost:5432/vedixa_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=super-secret-dev-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-dev-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# ─── AI Providers ─────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# AI Tier Config (tokens per day per plan)
AI_FREE_DAILY_DOUBTS=3
AI_PRO_DAILY_DOUBTS=30
AI_FREE_MAX_TOKENS=450
AI_PRO_MAX_TOKENS=1200

# ─── Object Storage (Cloudflare R2 compatible) ───────────────────────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=vedixa-dev
R2_PUBLIC_URL=http://localhost:9000

# ─── SMS Gateway ──────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id
MSG91_SENDER_ID=VEDIXA

# ─── App Config ───────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_NAME=VEDIXA
ENCRYPTION_KEY=32-byte-hex-encryption-key-here!!

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_WINDOW_AUTH=60000
RATE_LIMIT_MAX_AI=5
RATE_LIMIT_WINDOW_AI=60000
RATE_LIMIT_MAX_DEFAULT=100
RATE_LIMIT_WINDOW_DEFAULT=60000
